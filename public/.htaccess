# One address for search engines: https://iraveyou.online. Every variant
# (www, plain http, an old path) reaches its final https address in one hop.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # www → the bare domain over https, in one hop (http://www too).
  RewriteCond %{HTTP_HOST} ^www\.iraveyou\.online$ [NC]
  RewriteRule ^(.*)$ https://iraveyou.online/$1 [R=301,L]
  # The sequencer pages were removed: send their old addresses to the artist page.
  RewriteRule ^(acnd|apurba)/sequencer(?:/.*)?$ https://iraveyou.online/$1/ [R=301,L]
  # A page has one address: /journal/index.html → /journal/ (only when asked
  # for by name, not when the server serves the folder's index itself).
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
  RewriteRule ^ https://iraveyou.online/%1 [R=301,L]
  # Folders without a page of their own answer with their nearest page
  # instead of a bare 403: the sets live on /radio/, the legal pages start
  # with the terms.
  RewriteRule ^mix(?:es)?/?$ https://iraveyou.online/radio/ [R=301,L]
  RewriteRule ^legal/?$ https://iraveyou.online/legal/terms/ [R=301,L]
  # Plain http → https://iraveyou.online (a proxy in front of Apache may have
  # ended TLS already, so its X-Forwarded-Proto counts as https). The rules
  # above already send their own addresses straight to https.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^(.*)$ https://iraveyou.online/$1 [R=301,L]
  # The mix only plays from this site: a request for the audio that does not
  # come from one of its pages (an address pasted into a browser or a download
  # manager, another site embedding it) is refused.
  RewriteCond %{REQUEST_URI} \.(m4a|bin)$ [NC]
  # (Hostinger's per-pull-request previews, *.hostingersite.com, are let through too.)
  RewriteCond %{HTTP_REFERER} !^https://((www\.)?iraveyou\.online|[a-z0-9-]+\.hostingersite\.com)/ [NC]
  RewriteRule ^ - [F,L]
</IfModule>

# Unknown addresses get the site's own page (still with a 404 or 403 status),
# with a way back to the music, instead of the host's stock page.
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# The mix's file name carries its content hash, so it can be cached for a
# year: repeat visits play the set from disk instead of the network.
<IfModule mod_mime.c>
  AddType audio/mp4 .m4a
</IfModule>
<IfModule mod_headers.c>
  # Pages always revalidate, so a deploy never serves old HTML pointing at
  # removed assets; so does the release list, which changes without a new build.
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # The two unhashed stylesheets in public/ revalidate too (a cheap 304), so a
  # deploy never pairs new HTML with yesterday's styles.
  <FilesMatch "^(seo|brand)\.css$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Fonts and images change rarely: a month, refreshed quietly in the background.
  <FilesMatch "\.(woff2|webp|avif|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(m4a|bin)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ── Security headers ──
  # Scripts, styles, fonts, audio and frames come from this site only (plus
  # Google Analytics once a Measurement ID is set): an injected or third-party
  # script cannot run, and nothing can lift the page's content off to another
  # server. No plugins, no foreign <base>, and other sites cannot frame it.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://widget.mixcloud.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://player-widget.mixcloud.com https://www.mixcloud.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  # The page may not use the microphone, the camera, screen or tab capture,
  # location or any device ports, and neither may anything injected into it.
  Header always set Permissions-Policy 'camera=(), microphone=(), display-capture=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=(), browsing-topics=(), picture-in-picture=(), fullscreen=(self), autoplay=(self "https://player-widget.mixcloud.com")'
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # The audio, images and fonts load only on this site's own pages: other
  # sites cannot embed them. The press kit stays open for the press.
  SetEnvIf Request_URI "^/(audio|img|fonts|assets)/" IRY_OWN
  Header always set Cross-Origin-Resource-Policy "same-origin" env=IRY_OWN
</IfModule>
